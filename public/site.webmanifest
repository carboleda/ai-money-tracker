{
  "id": "zolvent_app",
  "name": "Zolvent",
  "short_name": "Zolvent",
  "description": "Your personal finance tracker powered by AI",
  "start_url": "/login",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#45c431",
  "scope": "/",
  "categories": ["finance", "productivity", "tools"],
  "shortcuts": [
    {
      "url": "/private/transactions?new_trx=true",
      "name": "New Transaction",
      "short_name": "New Transaction",
      "description": "Quickly add a new transaction using AI",
      "icons": [
        {
          "src": "/shortcuts/new_trx.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "url": "/private/recurring-expenses/management",
      "name": "Pay Pending Bills",
      "short_name": "Pending",
      "description": "View your pending bills and pay them with ease",
      "icons": [
        {
          "src": "/shortcuts/pending.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "url": "/private",
      "name": "View Summary",
      "short_name": "Summary",
      "description": "View your transaction history and manage your finances",
      "icons": [
        {
          "src": "/shortcuts/summary.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/favicon/favicon.ico",
      "sizes": "48x48",
      "type": "image/x-icon"
    },
    {
      "src": "/favicon/favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/favicon/favicon-48x48.png",
      "sizes": "48x48",
      "type": "image/png"
    },
    {
      "src": "/favicon/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/favicon/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/favicon/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile_screenshot_menu.png",
      "sizes": "722x1472",
      "type": "image/png",
      "form_factor": "narrow",
